{
  "name": "search-mcp-server", 
  "version": "1.0.0",
  "description": "MCP server with search and fetch tools for ChatGPT Connectors",
  "main": "dist-server/main.js",
  "type": "module",
  "scripts": {
    "build:auth": "tsc -p tsconfig.auth.json",
    "build:server": "tsc -p tsconfig.server.json && npm run copy-data:server",
    "build": "npm run build:auth && npm run build:server",
    "start:auth": "node dist-auth/main.js",
    "start:server": "node dist-server/main.js",
    "start": "npm-run-all -p start:auth start:server",
    "copy-data:server": "mkdir -p dist-server/data && cp -R src-server/data/* dist-server/data/",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@scalekit-sdk/node": "^2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.5",
    "node-fetch": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "winston": "^3.10.0",
    "yaml": "^2.4.1",
    "zod": "^3.25.57"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/node": "^20.11.19",
    "@types/node-fetch": "^3.0.3",
    "typescript": "^5.4.5"
  }
}
