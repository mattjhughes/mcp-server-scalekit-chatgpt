# ============================================================================
# ScaleKit OAuth 2.1 Configuration
# ============================================================================
# These values come from your ScaleKit admin dashboard
# Navigate to: Resources > Your Resource > Client Credentials

# ScaleKit environment URL - your organization's ScaleKit domain
SK_ENV_URL=https://your-org.scalekit.com

# Client ID from ScaleKit resource configuration
# This identifies your MCP server as a resource server
SK_CLIENT_ID=your_scalekit_client_id_here

# Client Secret from ScaleKit resource configuration  
# Keep this secure - used for token validation
SK_CLIENT_SECRET=your_scalekit_client_secret_here

# MCP Server Resource ID from ScaleKit
# This is the resource identifier (starts with "res_")
MCP_SERVER_ID=res_your_resource_id_here


# ============================================================================
# Server Configuration
# ============================================================================

# Port for the Express server to run on
# Default: 3000 (matches MCP protocol expectations)
PORT=3000

# Public base URL for this server
# For development: Use your ngrok HTTPS URL
# For production: Use your actual domain
# This MUST match the URL registered in ScaleKit
PUBLIC_BASE_URL=https://abc123def456.ngrok-free.app


# ============================================================================
# Development with ngrok
# ============================================================================
# 
# 1. Install ngrok: brew install ngrok (or download from ngrok.com)
# 2. Start tunnel: ngrok http 3000
# 3. Copy the HTTPS URL (e.g., https://a8625812ea67.ngrok-free.app)  
# 4. Update PUBLIC_BASE_URL above with your ngrok URL
# 5. Update ScaleKit resource configuration with same URL
#
# Note: ngrok URLs change each time you restart, so you'll need to:
# - Update this .env file
# - Update ScaleKit resource configuration
# - Restart your MCP server
#
# For persistent URLs, consider ngrok's paid plan or deploy to a cloud service
#


# ============================================================================
# ScaleKit Setup Instructions
# ============================================================================
#
# 1. Create ScaleKit Account:
#    - Go to scalekit.com and create an account
#    - Set up your organization
#
# 2. Create a Resource:
#    - Navigate to Resources in the admin dashboard
#    - Click "Create Resource"
#    - Set Resource URL to your ngrok URL
#    - Enable OAuth 2.1 with PKCE
#    - Enable Dynamic Client Registration
#
# 3. Configure Client:
#    - Copy Client ID and Client Secret to this file
#    - Copy Resource ID (res_xxxxx) to MCP_SERVER_ID
#    - Set allowed redirect URIs (for ChatGPT: https://chatgpt.com/...)
#
# 4. Test Configuration:
#    - Start your server: npm start
#    - Visit: http://localhost:3000/.well-known/oauth-protected-resource
#    - Should return JSON with your configuration
#


# ============================================================================
# ChatGPT Connectors Integration
# ============================================================================
#
# To use with ChatGPT custom connectors:
#
# 1. In ChatGPT, create a new connector
# 2. Set Resource URL: your PUBLIC_BASE_URL from above
# 3. Choose OAuth 2.0 with authorization code flow
# 4. Enable "Dynamic client registration"
# 5. ChatGPT will automatically discover OAuth endpoints
# 6. Test the connection - you should be able to search the food database
#
# Available ChatGPT queries after setup:
# - "Search for people who like Korean food"  
# - "Find Matt's favorite food details"
# - "Who likes spicy food in the database?"
# - "Get details for person_2"
#


# ============================================================================
# Security Notes
# ============================================================================
#
# - Never commit this file to version control with real credentials
# - SK_CLIENT_SECRET should be treated as a password
# - PUBLIC_BASE_URL must use HTTPS in production
# - ngrok free tier exposes your local server to the internet
# - Consider firewall rules for production deployments
# - All MCP requests require valid OAuth tokens from ScaleKit
#